# ============================================================================
# CryptoTrace Intelligence — Environment Configuration Template
# SECURITY WARNING: NEVER commit actual secrets, private keys, or API tokens.
# Keep all database credentials and signing keys strictly on the backend!
# ============================================================================

# Database Connection (Backend / Server Only)
DATABASE_URL=postgresql://cryptotrace_app:replace_with_secure_password@localhost:5432/cryptotrace_db
DATABASE_SSL=true

# Supabase Cloud Database & Authentication
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Security & Authentication (Backend Only — NEVER EXPOSE IN VITE / FRONTEND)
JWT_SECRET=replace_with_fips_140_compliant_random_256bit_key
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=12

# Cryptographic Integrity & Evidence Signing (Backend Only)
HMAC_SECRET_KEY=replace_with_evidence_hmac_signing_key
KMS_MASTER_KEY_ID=arn:aws:kms:us-gov-east-1:123456789012:key/replace_with_kms_id

# Multi-Chain RPC & Indexer Endpoints (Real Data Configuration)
# Default public endpoints are free and work immediately without API keys.
# For high-throughput enterprise tracing, replace with your dedicated API keys (Alchemy, Infura, QuickNode, Helius, Etherscan).

# Ethereum & EVM Chains
VITE_ETH_RPC_URL=https://ethereum-rpc.publicnode.com
VITE_ETHERSCAN_API_URL=https://eth.blockscout.com/api
VITE_ETHERSCAN_API_KEY=

# Bitcoin Network (UTXO)
VITE_BTC_MEMPOOL_URL=https://mempool.space/api

# Solana Network (SOL & SPL Tokens)
VITE_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# TRON Network (TRX & TRC-20 USDT)
VITE_TRON_API_URL=https://api.trongrid.io
VITE_TRON_API_KEY=

# Avalanche C-Chain
VITE_AVAX_RPC_URL=https://api.avax.network/ext/bc/C/rpc

# Client Safe Public Configuration (Only public URLs allowed with VITE_ prefix)
VITE_APP_TITLE=CryptoTrace Intelligence
VITE_API_BASE_URL=http://localhost:3000/api/v1
